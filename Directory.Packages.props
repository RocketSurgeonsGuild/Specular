<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <GlobalPackageReference Include="Rocket.Surgery.MSBuild.CI" Version="1.3.0-beta.2" />
    <GlobalPackageReference Include="Rocket.Surgery.MSBuild.GlobalAnalyzerConfig" Version="1.3.0-beta.2" />
    <GlobalPackageReference Include="Rocket.Surgery.MSBuild.GitVersion" Version="1.3.0-beta.2" />
    <GlobalPackageReference Include="Rocket.Surgery.MSBuild.SourceLink" Version="1.3.0-beta.2" />
    <PackageVersion Include="Rocket.Surgery.AssemblyInfo" Version="2026.11.2" />
    <GlobalPackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0" />
    <GlobalPackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
    <GlobalPackageReference Include="Microsoft.SourceLink.GitHub" Version="11.0.100" />
    <GlobalPackageReference Include="Microsoft.DotNet.ApiCompat.Task" Version="11.0.100" />
    <GlobalPackageReference Include="Roslynator.Analyzers" Version="5.0.1" />
    <GlobalPackageReference Include="Roslynator.Formatting.Analyzers" Version="5.0.1" />
    <GlobalPackageReference Include="Roslynator.CodeAnalysis.Analyzers" Version="5.0.1" />
    <GlobalPackageReference Include="Roslynator.CodeFixes" Version="5.0.1" />
    <GlobalPackageReference Include="Roslynator.Refactorings" Version="5.0.1" />
    <GlobalPackageReference Include="ZeroAlloc.Analyzers" Version="1.13.0" />
    <GlobalPackageReference Include="FakeItEasy.Analyzer.CSharp" Version="6.1.1" />
    <GlobalPackageReference Include="JetBrains.ExternalAnnotations" Version="10.2.172" />
    <GlobalPackageReference Include="JetBrains.Annotations.Sources" Version="2026.2.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- The build host (build/Build.cs). The library targets net11.0 only (ModularPipelines 4 ships net11.0 assets only), and its
         Dovetail joints and Specular scan results are generated into the host, so both have to be direct references there. -->
    <PackageVersion Include="Rocket.Surgery.ModularPipelines.Extensions" Version="0.2.3" />
    <PackageVersion Include="Joinery.Dovetail.ModularPipelines" Version="0.5.3" />
    <PackageVersion Include="Specular" Version="0.4.1" />
    <PackageVersion Include="Sourcy.DotNet" Version="1.1.1" />
    <PackageVersion Include="Sourcy.Git" Version="1.1.1" />
    <PackageVersion Include="Microsoft.VisualStudio.SolutionPersistence" Version="1.0.52" />
  </ItemGroup>
  <ItemGroup>
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Features" Version="5.9.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CrashDump" Version="2.5.3" />
    <PackageVersion Include="Microsoft.Testing.Extensions.HangDump" Version="2.5.3" />
    <!-- The roslyn5.9 analyzer slice runs in the .NET 10.0.4xx SDK compiler (net10.0 runtime): keep these on 10.0.x. -->
    <PackageVersion Include="System.Collections.Immutable" Version="10.0.15" />
    <PackageVersion Include="Polyfill" Version="11.4.5" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="System.Text.Json" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Reactive.Testing" Version="7.0.0" />
    <PackageVersion Include="Bogus" Version="35.6.5" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="Rocket.Surgery.Extensions.Testing.FakeItEasy" Version="11.0.1" />
    <PackageVersion Include="Rocket.Surgery.Extensions.Testing.TUnit" Version="11.0.1" />
    <PackageVersion Include="Rocket.Surgery.Extensions.Testing.SourceGenerators" Version="11.0.1" />
    <PackageVersion Include="TUnit" Version="1.84.0" />
    <PackageVersion Include="Verify.TUnit" Version="33.4.0" />
  </ItemGroup>
  <ItemGroup Condition="!$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net11.0'))">
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.15" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.15" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Maui.Controls" Version="10.0.130" />
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net11.0'))">
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Maui.Controls" Version="11.0.10" />
  </ItemGroup>
</Project>
