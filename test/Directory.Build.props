<Project>
    <!-- Before the parent import: the SDK it applies only wires up test extensions when IsTestProject is already true. -->
    <PropertyGroup>
        <IsTestProject>true</IsTestProject>
        <!--
            Nothing under test/ ships. Rocket.Surgery.Sdk only defaults IsPackable to false for test and sample projects, so a
            fixture library that sets IsTestProject=false (TestAssembly) would otherwise be packed and pushed with the release.
        -->
        <IsPackable>false</IsPackable>
        <!-- The build pipeline passes its own coverage settings; the option takes one value. -->
        <RsgSdk_Testing_CoverageSettings>false</RsgSdk_Testing_CoverageSettings>
    </PropertyGroup>
    <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
    <PropertyGroup>
        <!--
            The repo-wide LatestMajor would run the net10.0 tests on the newest installed runtime (11.0.x once it's GA), which
            changes the generated compilations' diagnostics (CS1701). Keep each target on its own major: mise installs the
            net10.0 runtime alongside the SDK for exactly this.
        -->
        <RollForward>Minor</RollForward>
    </PropertyGroup>
</Project>
