<Project>
    <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
    <PropertyGroup>
        <_Analyzer_Roslyn_Version_>$(MSBuildProjectName.Replace('Specular.Analyzers.', ''))</_Analyzer_Roslyn_Version_>
        <DefineConstants>$(DefineConstants);$(_Analyzer_Roslyn_Version_.Replace('.', '_').ToUpper())</DefineConstants>
        <BaseOutputPath>bin/$(_Analyzer_Roslyn_Version_)/</BaseOutputPath>
        <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)obj/$(_Analyzer_Roslyn_Version_)/</BaseIntermediateOutputPath>
        <NoWarn>NU5105;$(NoWarn)</NoWarn>
        <AssemblyName>Specular.Analyzers</AssemblyName>
        <IsPackable>false</IsPackable>
        <NoPackageAnalysis>true</NoPackageAnalysis>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <TargetFramework>netstandard2.0</TargetFramework>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
        <GenerateAssemblyInfoManifest>false</GenerateAssemblyInfoManifest>
        <AssemblyInfoDependencies>false</AssemblyInfoDependencies>
        <!-- The namespace Specular.Analyzers generates AssemblyInfo in, for the shared sources (the default, the project name, isn't one). -->
        <AssemblyInfoNamespace>Specular.Analyzers</AssemblyInfoNamespace>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <!--
            These builds compile Specular.Analyzers' own sources against older Roslyn versions, and Specular.Analyzers runs the analyzers
            over the same files. Running them here again cost about half of each compile (the three builds start together, first on the
            build's critical path) and produced the same assembly: the output is byte-identical without them.
        -->
        <RunAnalyzers>false</RunAnalyzers>
    </PropertyGroup>
</Project>
