<Project>
    <PropertyGroup>
      <_SpecularApplicationDetected Condition="'$(_SpecularApplicationDetected)' == '' and ('$(OutputType)' != 'Library' and '$(OutputType)' != 'library')">true</_SpecularApplicationDetected>
      <_SpecularApplicationDetected Condition="'$(_SpecularApplicationDetected)' == '' and ('$(UsingMicrosoftNETSdkBlazorWebAssembly)' == 'true')">true</_SpecularApplicationDetected>
      <_SpecularApplicationDetected Condition="'$(_SpecularApplicationDetected)' == ''">false</_SpecularApplicationDetected>
    </PropertyGroup>
    <PropertyGroup Condition="'$(IsTestProject)' == 'true' or '$(_SpecularApplicationDetected)' == 'true'">
      <SpecularEmitProvider Condition="'$(SpecularEmitProvider)' == ''">true</SpecularEmitProvider>
      <SpecularGenerateDiagnostics Condition="'$(SpecularGenerateDiagnostics)' == ''">true</SpecularGenerateDiagnostics>
    </PropertyGroup>
    <PropertyGroup Condition="$(Configuration.Contains('Debug'))">
      <SpecularGenerateDiagnostics Condition="'$(SpecularGenerateDiagnostics)' == ''">true</SpecularGenerateDiagnostics>
    </PropertyGroup>
    <PropertyGroup>
      <SpecularGenerateDiagnostics Condition="'$(SpecularGenerateDiagnostics)' == ''">false</SpecularGenerateDiagnostics>
    </PropertyGroup>

    <ItemGroup Condition="'$(ImplicitUsings)' == 'true' or '$(ImplicitUsings)' == 'enable'">
        <Using Include="Specular" />
    </ItemGroup>
    <!--
        The generator's cache, $(IntermediateOutputPath)ctp/SpecularProvider.ctpjson, is a Specular.Scanning scan cache: the shared wiring
        feeds it back as an AdditionalFile just before CoreCompile and deletes it on Clean. The package carries a copy beside this file;
        in this repository it is read from Specular.Scanning. The guard keeps it to one import when another generator brings it too.
    -->
    <PropertyGroup>
        <_SpecularScanningCacheTargets>$(MSBuildThisFileDirectory)Specular.Scanning.Cache.targets</_SpecularScanningCacheTargets>
        <_SpecularScanningCacheTargets Condition="!Exists('$(_SpecularScanningCacheTargets)')">$(MSBuildThisFileDirectory)../../Specular.Scanning/build/Specular.Scanning.Cache.targets</_SpecularScanningCacheTargets>
    </PropertyGroup>
    <Import Project="$(_SpecularScanningCacheTargets)" Condition="'$(_SpecularScanningCacheImported)' != 'true' and Exists('$(_SpecularScanningCacheTargets)')" />
</Project>
