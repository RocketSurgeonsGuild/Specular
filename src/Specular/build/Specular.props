<Project>
    <ItemGroup>
        <CompilerVisibleProperty Include="IntermediateOutputPath" />
        <CompilerVisibleProperty Include="ProjectDir" />
        <!-- Set from SpecularExcludeAssemblies and SpecularIncludeAssemblies in Specular.targets. -->
        <CompilerVisibleProperty Include="SpecularProviderExcludeAssemblies" />
        <CompilerVisibleProperty Include="SpecularProviderIncludeAssemblies" />
        <CompilerVisibleProperty Include="SpecularEmitProvider" />
        <CompilerVisibleProperty Include="PublishAot" />
        <CompilerVisibleProperty Include="EnableAotAnalyzer" />
    </ItemGroup>
</Project>
