<Project Sdk="Microsoft.NET.Sdk">
    <Import Project="build/Specular.props" />
    <PropertyGroup>
        <TargetFrameworks>netstandard2.0;net10.0;net11.0</TargetFrameworks>
        <IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0'))">true</IsAotCompatible>
        <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
        <SpecularGenerateDiagnostics>false</SpecularGenerateDiagnostics>
        <RuntimeAsyncBrowserWasmAsset>true</RuntimeAsyncBrowserWasmAsset>
    </PropertyGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="Specular.Extensions.Tests" />
        <PackageReference Include="Polyfill" PrivateAssets="all" />
        <ProjectReference
            Include="..\Specular.Analyzers\Specular.Analyzers.csproj"
            IncludeAssets="analyzers"
            ExcludeAssets="compile;runtime;native"
            PrivateAssets="contentfiles;build;buildMultitargeting;buildTransitive"
            OutputItemType="Analyzer"
        />
    </ItemGroup>
    <ItemGroup Condition="$(TargetFramework)=='netstandard2.0'">
    <PackageReference Include="System.Collections.Immutable" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    </ItemGroup>
    <ItemGroup>
        <None Include="build/*.*" Pack="true" PackagePath="build" />
        <None Include="buildMultiTargeting/*.*" Pack="true" PackagePath="buildMultiTargeting" />
        <None Include="buildTransitive/*.*" Pack="true" PackagePath="buildTransitive" />
    </ItemGroup>
    <Import Project="build/Specular.targets" />
</Project>
