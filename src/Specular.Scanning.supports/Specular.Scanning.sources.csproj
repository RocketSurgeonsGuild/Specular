<Project Sdk="Microsoft.NET.Sdk">
    <!--
        Never packed: compiles the library the way Specular.Scanning.Sources consumers do (types internal, oldest supported Roslyn, C# 14,
        no implicit or repo-wide global usings), so a change that breaks source consumers fails this repository's build instead of theirs.
    -->
    <PropertyGroup>
        <DefineConstants>$(DefineConstants);SPECULAR_SCANNING_SOURCES;SPECULAR_SCANNING_EXPLICIT_USINGS</DefineConstants>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <ImplicitUsings>disable</ImplicitUsings>
    </PropertyGroup>
    <ItemGroup>
        <Using Remove="@(Using)" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" VersionOverride="5.12.0" PrivateAssets="all" />
        <PackageReference Include="System.Collections.Immutable" VersionOverride="9.0.23" />
        <PackageReference Include="System.Text.Json" VersionOverride="9.0.23" PrivateAssets="all" />
    </ItemGroup>
</Project>
