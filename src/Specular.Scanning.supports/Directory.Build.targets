<Project>
    <ItemGroup>
        <PackageReference Include="Polyfill" PrivateAssets="all" />
        <Compile Include="$(MSBuildThisFileDirectory)..\Specular.Scanning\**\*.cs" Exclude="$(MSBuildThisFileDirectory)..\Specular.Scanning\obj\**\*.cs;$(MSBuildThisFileDirectory)..\Specular.Scanning\bin\**\*.cs" />
    </ItemGroup>
    <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.targets', '$(MSBuildThisFileDirectory)../'))" />
</Project>
