<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <TargetFramework>netstandard2.0</TargetFramework>
        <IsRoslynComponent>true</IsRoslynComponent>
        <DefineConstants>$(DefineConstants);ROSLYN_CURRENT</DefineConstants>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <NoWarn>$(NoWarn);MSB3277</NoWarn>
        <_AnalyzersLocation>../Specular.Analyzers.supports/bin/</_AnalyzersLocation>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
        <PackageReference Include="Polyfill" PrivateAssets="all" />
       <PackageReference Include="System.Collections.Immutable" />
        <PackageReference Include="System.Text.Json" PrivateAssets="all" GeneratePathProperty="true" />
      <!--
          Built only so their outputs can be packed below. Private="false" keeps their content (each copies its System.Text.Json.dll
          to its own output for packing) from flowing on to this project and every app that references the generator, where two
          versions of it collided in Uno's WebAssembly assets.
      -->
      <ProjectReference Include="../Specular.Analyzers.supports/Specular.Analyzers.roslyn5.0.csproj" PrivateAssets="all" ReferenceOutputAssembly="false" Private="false" />
      <ProjectReference Include="../Specular.Analyzers.supports/Specular.Analyzers.roslyn5.3.csproj" PrivateAssets="all" ReferenceOutputAssembly="false" Private="false" />
      <ProjectReference Include="../Specular.Analyzers.supports/Specular.Analyzers.roslyn5.6.csproj" PrivateAssets="all" ReferenceOutputAssembly="false" Private="false" />
    </ItemGroup>
    <ItemGroup>
    <None Include="bin\$(Configuration)\netstandard2.0\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/roslyn5.9/cs" Visible="false" />
    <None Include="$(PkgSystem_Text_Json)\lib\netstandard2.0\System.Text.Json.dll" Pack="true" PackagePath="analyzers/dotnet/roslyn5.9/cs" Visible="false" />
    <None Include="$(_AnalyzersLocation)roslyn5.6/$(Configuration)/netstandard2.0/Specular.Analyzers.dll" Pack="true" PackagePath="analyzers/dotnet/roslyn5.6/cs" Visible="false" />
    <None Include="$(_AnalyzersLocation)roslyn5.6/$(Configuration)/netstandard2.0/System.Text.Json.dll" Pack="true" PackagePath="analyzers/dotnet/roslyn5.6/cs" Visible="false" />
        <None Include="$(_AnalyzersLocation)roslyn5.3/$(Configuration)/netstandard2.0/Specular.Analyzers.dll" Pack="true" PackagePath="analyzers/dotnet/roslyn5.3/cs" Visible="false" />
        <None Include="$(_AnalyzersLocation)roslyn5.3/$(Configuration)/netstandard2.0/System.Text.Json.dll" Pack="true" PackagePath="analyzers/dotnet/roslyn5.3/cs" Visible="false" />
        <None Include="$(_AnalyzersLocation)roslyn5.0/$(Configuration)/netstandard2.0/Specular.Analyzers.dll" Pack="true" PackagePath="analyzers/dotnet/roslyn5.0/cs" Visible="false" />
        <None Include="$(_AnalyzersLocation)roslyn5.0/$(Configuration)/netstandard2.0/System.Text.Json.dll" Pack="true" PackagePath="analyzers/dotnet/roslyn5.0/cs" Visible="false" />
    </ItemGroup>
</Project>
