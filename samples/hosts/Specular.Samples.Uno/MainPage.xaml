<Page
    x:Class="Specular.Samples.UnoPlatform.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
>
    <ScrollViewer>
        <StackPanel Margin="24" Spacing="8">
            <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="Specular on Uno Platform" />
            <TextBlock x:Name="SummaryText" AutomationProperties.AutomationId="SpecularResult" TextWrapping="Wrap" />
            <ItemsControl x:Name="ServicesList" />
        </StackPanel>
    </ScrollViewer>
</Page>
