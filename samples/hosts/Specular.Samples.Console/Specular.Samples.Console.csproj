<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <!-- AOT publish is exercised on both target frameworks (build/Samples.cs). -->
        <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
        <!-- Shared sample scan + the three sample libraries, consumed like a packaged consumer (samples/Directory.Build.targets). -->
        <SpecularSampleHost>true</SpecularSampleHost>
        <!-- Native AOT guardrail target (US2/US3). Build/run are unaffected; only publish AOT-compiles. -->
        <PublishAot>true</PublishAot>
        <InvariantGlobalization>true</InvariantGlobalization>
        <!-- Zero-warning AOT policy (D4-pinned): surface each trim/AOT warning individually and
             promote every IL2xxx/IL3xxx to an error so the publish FAILS on any trim/AOT warning. -->
        <TrimmerSingleWarn>false</TrimmerSingleWarn>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    </ItemGroup>
</Project>
