<Project>
    <!--
        Conditional-workload guard (Decision D1).

        Goal: `dotnet build Specular.slnx` MUST stay green on a machine/runner that has NO workloads installed.

        - The MAUI and Uno hosts need workloads for most of their heads, so Specular.slnx doesn't build them
          (<Build Project="false" />). .github/workflows/samples.yml installs the workloads each OS can use and picks the heads
          with SpecularSampleTargetFrameworks (';' passed as %3B):
              dotnet build samples/hosts/Specular.Samples.Maui -p:SpecularSampleTargetFrameworks=net10.0-android%3Bnet11.0-android
        - SpecularSamplesWasmAotEnabled : Blazor WASM builds & publishes fine without `wasm-tools`;
                                        only `RunAOTCompilation=true` needs it. This flag gates the
                                        AOT switch, defaulting OFF so a normal build never requires
                                        the workload.  dotnet publish -p:SpecularSamplesWasmAotEnabled=true
    -->
    <PropertyGroup>
        <SpecularSamplesWasmAotEnabled Condition="'$(SpecularSamplesWasmAotEnabled)' == ''">false</SpecularSamplesWasmAotEnabled>
    </PropertyGroup>
</Project>
